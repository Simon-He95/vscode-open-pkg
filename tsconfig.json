{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["esnext"],
    "module": "CommonJS",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  }
}
